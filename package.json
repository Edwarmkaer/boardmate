{
  "name": "boardmate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@boardmate/desktop",
    "build": "turbo run build",
    "check": "biome check . && turbo run check",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "desktop:dev": "pnpm --filter @boardmate/desktop tauri dev",
    "desktop:build": "pnpm --filter @boardmate/desktop tauri build",
    "rust:test": "cargo test --workspace --exclude boardmate-desktop",
    "rust:check": "cargo fmt --all --check && cargo clippy --workspace --exclude boardmate-desktop --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}

# Native Rust process only. Never prefix these variables with NEXT_PUBLIC_.
# Demo mode works offline and uses explicitly simulated boards.
BOARDMATE_PROVIDER=demo
BOARDMATE_MODEL=llama-3.3-70b-versatile
BOARDMATE_API_BASE_URL=https://api.groq.com/openai/v1
# Set BOARDMATE_PROVIDER=groq and provide your own key to enable real inference.
GROQ_API_KEY=
# For BOARDMATE_PROVIDER=compatible, set your endpoint, model and this key.
BOARDMATE_API_KEY=
